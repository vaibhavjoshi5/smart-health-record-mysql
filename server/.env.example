# Aiven MySQL connection (copy this file to .env; never commit .env)
MYSQL_HOST=your-aiven-host.aivencloud.com
MYSQL_PORT=12345
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=replace-with-aiven-password
MYSQL_SSL=true
# Paste the Aiven CA certificate as one line, replacing line breaks with \n.
MYSQL_SSL_CA=
MYSQL_CONNECTION_LIMIT=5

PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
EMAIL_USER=
EMAIL_PASS=
